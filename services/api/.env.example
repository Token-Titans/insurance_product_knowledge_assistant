APP_ENV=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Server-side only. Copy this file to .env and add the key locally. Never commit .env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Server-side only. Leave empty to disable follow-up.
# Test (n8n editor listening):  https://HOST/webhook-test/insureassist-followup
# Production (workflow Active): https://HOST/webhook/insureassist-followup
N8N_WEBHOOK_URL=
